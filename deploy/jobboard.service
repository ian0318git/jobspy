[Unit]
Description=Embedded Job Board dashboard (job_board.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ian/github-project/jobspy
# 不緩衝：這支程式的輸出進 systemd 的 append: 日誌時是 block-buffered，
# 不設的話啟動訊息與 [watchdog]/[jobscan] 的診斷會卡在緩衝區裡，
# 出事時翻 job_board.log 什麼都看不到。
Environment=PYTHONUNBUFFERED=1
# 綁定位址可用環境變數覆蓋（job_board.py:45 的程式預設是 0.0.0.0）。
# 範本刻意保持 loopback：這是可攜的保守預設，本地 VM 與 VPS 共用同一份範本，
# 而兩台的實際位址不同 —— 所以機器專屬的值不該寫在這裡。
#
# 【機器專屬的值請用 drop-in 覆蓋，不要改這份範本】
#   ~/.config/systemd/user/jobboard.service.d/local.conf
# 因為 `install -m 644 deploy/jobboard.service ~/.config/systemd/user/`（見 deploy/README.md）
# 會整份覆蓋安裝後的副本，寫在範本裡的機器專屬設定會在下次安裝時靜默消失。
#
# 本地 VM 的 drop-in 實際內容（讓宿主機 192.168.44.1 的瀏覽器連得到）：
#   [Service]
#   Environment=JOB_BOARD_HOST=192.168.44.128
#   Environment=JOB_BOARD_LABEL=Local
#
# 【2026-09-21 更正】此處原寫「2026-09-19 檢視 job_board.log，所有請求來源本來就都是
# 127.0.0.1」—— 那是取樣偏誤，不是事實。job_board.log-2026-09-19.gz 是輪替累積檔，
# 內有 993 筆來自 192.168.44.1 的請求（宿主機瀏覽器），最後一筆 19/Sep 10:35:06，
# 而檔尾 3 筆全是 loopback —— 只看尾端自然得到「本來就都是 127.0.0.1」。
# 這個錯誤讓看板自 09-19 起對使用者完全無法使用；09-20、09-21 宿主機流量皆為 0，
# 09-22 綁回 LAN IP 後恢復。
#
# ⚠️ 原版本此處另寫「loopback 設定是當晚 21:18 才寫入的。遠端流量在改設定前 11 小時
# 就停止了」——**那句查不到支持證據，已於 2026-09-30 移除**。log 顯示 09-19 當天
# loopback 請求從 10:36:34 才首次出現，與 21:18 有張力；但那批是穩定 30 秒間隔的輪詢，
# 也可能來自 VM 內部的用戶端而非綁定變更。兩種解釋都與現存證據相容，無法判定。
# 時間戳的來源不明，不要再往上疊推論。詳見 ../DECISIONS.md。
Environment=JOB_BOARD_HOST=127.0.0.1
# 排程主權在 jobscan.timer，所以這裡【刻意不設】任何排程相關環境變數：
# JOB_BOARD_INTERNAL_SCHEDULER 未設＝內建排程器停用，正是我們要的預設值。
# 要臨時救回內建排程器（例如 timer 壞掉時），用 systemctl --user edit 加
# Environment=JOB_BOARD_INTERNAL_SCHEDULER=1 後重啟，不要改這個檔案。
ExecStart=/home/ian/github-project/jobspy/.venv/bin/python /home/ian/github-project/jobspy/job_board.py
Restart=always
RestartSec=5
# 看板是常駐小程式（四十筆資料）。設上限是為了讓失控的記憶體成長撞到天花板
# 被 OOM 殺掉、再由 Restart=always 救回，而不是拖垮整台機器。
MemoryMax=512M
StandardOutput=append:/home/ian/github-project/jobspy/job_board.log
StandardError=append:/home/ian/github-project/jobspy/job_board.log

[Install]
WantedBy=default.target
